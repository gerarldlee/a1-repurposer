# --- AI (required - one of the providers below) ---
# Which provider generates post variants: openai | openrouter | opencodego | ollama
# (can also be switched at runtime in the Settings tab)
AI_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (one key for many models: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenCode Go (key from https://opencode.ai/auth; cheap subscription, OpenAI-compatible)
# Model must be one served on /chat/completions (e.g. glm-5.3-flash, kimi-k3, deepseek-v4-flash)
OPENCODE_API_KEY=
OPENCODE_GO_MODEL=glm-5.3-flash

# Ollama (local, free - no key needed; https://ollama.com)
# Model must support JSON output reasonably well (e.g. llama3.1, qwen2.5, mistral-nemo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Reddit (required for Reddit posting) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
# redirect URI should be: http://localhost:3000
# Note: username/password can also be set in the Settings UI; .env takes precedence.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- X (optional) ---
# If set, uses the official API v2 (free tier: 500 posts/month).
# If missing or a call fails, falls back to Playwright browser automation
# using a stored login session (click "Connect X Account" in Settings).
X_BEARER_TOKEN=

# --- App ---
PORT=3000